{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-hub-pro",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/go", "/go/*", "/healthz", "/about", "/contact", "/privacy", "/terms", "/tools/*", "/directory/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "env": {
    "staging": {
      "name": "world-hub-pro-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "STAGING": "true" },
      "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true
      }
    }
  }
}
