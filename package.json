{
  "name": "world-hub-pro",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run preview:cloudflare",
    "lint": "next lint",
    "build:cloudflare": "next build && node scripts/verify-cloudflare-build.mjs",
    "preview:cloudflare": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --env staging",
    "test:cloudflare": "tsx --test tests/cloudflare.test.ts",
    "smoke:cloudflare": "node scripts/smoke-cloudflare.mjs",
    "deploy:cloudflare:production": "npm run build:cloudflare && wrangler deploy --env \"\""
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "next": "~16.3.8",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
